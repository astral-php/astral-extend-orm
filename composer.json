{
    "name": "astral-php/astral-extend-orm",
    "description": "Extension ORM pour Astral — Fillable, Casts, Accessors, Hidden, Relations déclaratives",
    "type": "library",
    "version": "0.1.1",
    "license": "MIT",
    "keywords": [
        "astral",
        "orm",
        "php",
        "mvc",
        "model",
        "traits"
    ],
    "authors": [
        {
            "name": "astral-php",
            "homepage": "https://github.com/astral-php"
        }
    ],
    "homepage": "https://github.com/astral-php/astral-extend-orm",
    "support": {
        "source": "https://github.com/astral-php/astral-extend-orm",
        "issues": "https://github.com/astral-php/astral-extend-orm/issues"
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "suggest": {
        "astral-php/astral-core": "Applications Astral basées sur astral-core ^1.2"
    },
    "autoload": {
        "psr-4": {
            "AstralOrm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AstralOrm\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
